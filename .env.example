# Copy this file to ".env" and fill in real keys. NEVER commit .env.
# Each provider is optional — if a key is missing, that provider is simply skipped.

# Viator Partner API  (partner.viator.com -> API key; confirm your access tier)
VIATOR_API_KEY=
VIATOR_AFFILIATE_PID=P00167800
VIATOR_AFFILIATE_UID=U00485633
VIATOR_AFFILIATE_MCID=58086

# GetYourGuide Partner API  (partner.getyourguide.com)
GYG_API_KEY=
GYG_PARTNER_ID=

# Klook Affiliate / API
KLOOK_API_KEY=
KLOOK_AFFILIATE_ID=

# FareHarbor Distribution Network affiliate shortref (already in use)
FAREHARBOR_REF=everythinghawaiitravel

# Travelpayouts  (travelpayouts.com -> Profile -> API token; marker = your partner ID)
TP_TOKEN=
TP_MARKER=

# Google ratings — "Places API (New)" key (Google Cloud; free monthly credit covers it)
GOOGLE_PLACES_API_KEY=

# Stock photos — set ANY ONE (auto-detected, in this order). Pixabay = instant key.
PIXABAY_API_KEY=       # pixabay.com/api/docs  (instant, no approval)
UNSPLASH_ACCESS_KEY=   # unsplash.com/developers
PEXELS_API_KEY=        # pexels.com/api (new keys currently paused)

# Build mode: set USE_MOCK=1 to generate sample Beyond-Hawaii data without any API keys
USE_MOCK=1
